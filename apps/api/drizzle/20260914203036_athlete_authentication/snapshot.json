    {
      "value": "\"sport\" in ('running', 'cycling', 'swimming')",
      "name": "activities_sport",
      "entityType": "checks",
      "schema": "public",
      "table": "activities"
    },
    {
      "value": "\"started_at\" < \"created_at\"",
      "name": "activities_started_in_past",
      "entityType": "checks",
      "schema": "public",
      "table": "activities"
    },
    {
      "value": "\"duration_seconds\" between 1 and 9007199254740991",
      "name": "activities_duration",
      "entityType": "checks",
      "schema": "public",
      "table": "activities"
    },
    {
      "value": "\"distance_meters\" between 1 and 9007199254740991",
      "name": "activities_distance",
      "entityType": "checks",
      "schema": "public",
      "table": "activities"
    },
    {
      "value": "\"effort\" between 0 and 10",
      "name": "activities_effort",
      "entityType": "checks",
      "schema": "public",
      "table": "activities"
    },
    {
      "value": "(\n    (\"average_heart_rate\" is null and \"max_heart_rate\" is null) or\n    (\"average_heart_rate\" is not null and \"max_heart_rate\" is not null\n      and \"average_heart_rate\" > 0 and \"max_heart_rate\" <= 9007199254740991\n      and \"average_heart_rate\" <= \"max_heart_rate\")\n  )",
      "name": "activities_heart_rate",
      "entityType": "checks",
      "schema": "public",
      "table": "activities"
    },
    {
      "value": "(\n    (\"average_power\" is null and \"max_power\" is null) or\n    (\"sport\" in ('running', 'cycling')\n      and \"average_power\" is not null and \"max_power\" is not null\n      and \"average_power\" >= 0 and \"max_power\" < 'Infinity'::float8\n      and \"average_power\" <= \"max_power\")\n  )",
      "name": "activities_power",
      "entityType": "checks",
      "schema": "public",
      "table": "activities"
    },
    {
      "value": "\"average_swolf\" is null or\n    (\"sport\" = 'swimming' and \"average_swolf\" > 0 and \"average_swolf\" < 'Infinity'::float8)",
      "name": "activities_swolf",
      "entityType": "checks",
      "schema": "public",
      "table": "activities"
    },
    {
      "value": "\"duration_seconds\" <= extract(epoch from (\"created_at\" - \"started_at\"))",
      "name": "activities_completed",
      "entityType": "checks",
      "schema": "public",
      "table": "activities"
    },
    {
      "value": "\"updated_at\" >= \"created_at\"",
      "name": "activities_timestamp_order",
      "entityType": "checks",
      "schema": "public",
      "table": "activities"
    }
  ],
  "renames": []
