{
  "name": "@pacecraft/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "db:generate": "bunx --bun drizzle-kit generate",
    "db:migrate": "bunx --bun drizzle-kit migrate",
    "db:studio": "bunx --bun drizzle-kit studio --host=127.0.0.1",
    "dev": "bun --watch src/index.ts",
    "openapi:generate": "bun scripts/generate-openapi.ts",
    "start": "bun src/index.ts",
    "test": "bun test --pass-with-no-tests",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@pacecraft/contracts": "workspace:*",
    "drizzle-orm": "1.0.0-rc.5-169397b",
    "fastify": "5.12.4",
    "fastify-type-provider-zod": "7.0.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "drizzle-kit": "1.0.0-rc.5-ab785fc"
  }
}
