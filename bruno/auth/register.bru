meta {
  name: Register an athlete
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/sign-up/email
  body: json
  auth: none
}

headers {
  Origin: {{baseUrl}}
}

script:pre-request {
  bru.setVar("registrationEmail", "bruno-" + Date.now() + "@example.com");
}

body:json {
  { "name": "Bruno Athlete", "email": "{{registrationEmail}}", "password": "test-password-9fcb57e2" }
}

assert {
  res.status: eq 200
}

tests {
  test("Registration does not sign in", function () {
    expect(res.getBody().token).to.equal(null);
    expect(res.getHeader("set-cookie")).to.equal(undefined);
  });
}

script:post-response {
  bru.setVar("registeredUserId", res.getBody().user.id);
}
