meta {
  name: Reject an invalid registration password
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/sign-up/email
  body: json
  auth: none
}

body:json {
  { "name": "Bruno Athlete", "email": "bruno@example.com", "password": "short" }
}

assert {
  res.status: eq 400
  res.body.status: eq 400
}

tests {
  test("Returns Problem Details without echoing the password", function () {
    expect(res.getHeader("content-type")).to.contain("application/problem+json");
    expect(JSON.stringify(res.getBody())).not.to.contain("short");
  });
}
